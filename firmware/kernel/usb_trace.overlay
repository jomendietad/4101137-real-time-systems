/*
 * Tracing goes out the devkit's USB jack (USB-Serial-JTAG, /dev/ttyACM0); the
 * console stays on the UART jack. uart1 is no alternative: the board routes its
 * TX to GPIO17, which is instr_disp.
 */

/ {
	chosen {
		zephyr,tracing-uart = &usb_serial;
	};
};

&usb_serial {
	status = "okay";
};
